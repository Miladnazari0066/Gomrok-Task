# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Public Client-Side Supabase Configuration (safe for browser use with strict RLS)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Private Server-Side Supabase Configuration (NEVER prefix with VITE_ or expose to browser)
# Used exclusively by server.ts for atomic company onboarding and Supabase Auth user provisioning.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
