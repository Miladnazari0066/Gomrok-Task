# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Public Client-Side Supabase Configuration (safe for browser use with strict RLS)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
# Legacy fallback (optional if VITE_SUPABASE_PUBLISHABLE_KEY is set)
VITE_SUPABASE_ANON_KEY=""

# Optional Server-Side Supabase Configuration (NEVER prefix with VITE_ or expose to browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
